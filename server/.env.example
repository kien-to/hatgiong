# Claude API key for the Mầm tutor: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Local Supabase (`supabase start`). For a hosted project use its URL, publishable key and
# the Postgres connection string from Project Settings → Database.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
